# Semua ini otomatis diisi Vercel setelah connect Supabase lewat Marketplace.
# Untuk dev lokal: `vercel link` lalu `vercel env pull .env.local`

POSTGRES_URL=                # pooler, transaction mode — dipakai runtime app
POSTGRES_URL_NON_POOLING=    # direct connection — dipakai drizzle-kit migrate
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # dipakai kalau nanti akses Supabase Storage
